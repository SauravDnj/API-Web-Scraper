# Each user adds their own Serper API key after logging in - no key is needed here.

# Signs session cookies and encrypts stored API keys. REQUIRED on Vercel (use a long random string).
# Locally it is generated automatically into data/secret_key.txt if not set.
SECRET_KEY=

# Set automatically when a Vercel Blob store is connected. When empty, data is stored in ./data as JSON files.
BLOB_READ_WRITE_TOKEN=

PORT=5000
